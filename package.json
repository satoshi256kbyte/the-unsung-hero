{
  "name": "the-unsung-hero",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.build.json && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint src",
    "format": "biome format --write src",
    "check": "biome check --write src",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "license:check": "license-checker-rseidelsohn --production --onlyAllow 'MIT;Apache-2.0;BSD-2-Clause;BSD-3-Clause;ISC;0BSD;Python-2.0;CC0-1.0;Unlicense' --excludePackages 'the-unsung-hero'",
    "prepare": "husky",
    "lint:md": "markdownlint-cli2 '**/*.md' '#node_modules'"
  },
  "lint-staged": {
    "*.{ts,tsx}": ["biome check --write"],
    "*.md": ["markdownlint-cli2 --fix"]
  },
  "dependencies": {
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@playwright/test": "^1.50.0",
    "@vitest/coverage-v8": "^3.0.0",
    "fast-check": "^3.23.0",
    "husky": "^9.1.7",
    "license-checker-rseidelsohn": "^4.4.2",
    "lint-staged": "^17.3.0",
    "markdownlint-cli2": "^0.23.2",
    "typescript": "^5.8.0",
    "vite": "^6.3.0",
    "vitest": "^3.0.0"
  }
}
